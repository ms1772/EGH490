+/**
+ * @brief Report whether the external odometry source is still alive.
+ *
+ * The visual odometry timer re-stamps every message with now(), so a dead motion capture
+ * system would otherwise be invisible to PX4: it would keep receiving a frozen pose with
+ * fresh timestamps, consider the external vision healthy and run no failsafe.
+ */
+bool PixhawkPlatform::isExternalOdomFresh()
+{
+  bool fresh = false;
+  if (external_odom_received_) {
+    const double age = (this->get_clock()->now() - last_external_odom_time_).seconds();
+    fresh = (age >= 0.0) && (age < external_odom_timeout_s_);
+  }
+
+  // Edge triggered logging: one message per transition, never once per cycle.
+  if (!fresh && !external_odom_stale_) {
+    external_odom_stale_ = true;
+    RCLCPP_ERROR(
+      this->get_logger(),
+      "EXTERNAL ODOMETRY STALE (no sample for more than %.3f s): stopped publishing to "
+      "/fmu/in/vehicle_visual_odometry so PX4 can run its external vision failsafe",
+      external_odom_timeout_s_);
+  } else if (fresh && external_odom_stale_) {
+    external_odom_stale_ = false;
+    RCLCPP_INFO(
+      this->get_logger(),
+      "External odometry recovered: resuming /fmu/in/vehicle_visual_odometry");
+  }
+  return fresh;
+}
