<?xml version="1.0" encoding="UTF-8" ?>
<!-- cyclonedds_gs.xml : Cyclone DDS configuration for the GROUND STATION in
     hardware mode. The mirror image of the Jetson's ~/as2_o134_ws/cyclonedds.xml
     (generated by flight_ops/deploy/jetson_setup.sh): pin the GS's own fleet
     interface, name each aircraft as a unicast discovery peer, and refuse the
     locator the aircraft advertises that the GS cannot reach.

     HOW IT IS USED
       flight_ops/session_bringup.sh (hardware, ground role) renders a session
       copy of this file to /tmp/o134_cyclonedds_gs.xml -- with the interface
       and the peer list rewritten from its flags -- and exports
       CYCLONEDDS_URI=file:///tmp/o134_cyclonedds_gs.xml into every pane it
       starts. Nothing is written to ~/.bashrc. A shell that wants the same
       view of the fleet (ros2 topic list, ros2 topic hz) exports the same URI,
       then restarts the CLI daemon:  ros2 daemon stop; ros2 daemon start.

     THE JETSON ADDRESS IS A DHCP LEASE. 10.88.38.136 is what jetsonorinnx
     (drone0) held on 2026-09-11. If the lease has moved, do NOT edit this
     file in the lab: pass the current address to the launcher,
         session_bringup.sh ... --jetson-peer <ip>[,<ip>...]
     which rewrites the Peers block in the session copy. Multicast SPDP is
     still on, so a moved lease degrades to multicast-only discovery rather
     than to silence -- but on this wifi that is the fragile case, which is
     why the peers are named at all.

     MEASURED 2026-09-11 (bench integration test, drone0 + PX4 v1.17.0), from
     the GS with the uXRCE agent up on the Jetson:
       default Cyclone config ................ 0 /uav_0/fmu topics
       eth1 pinned + peer, no DontRoute ...... 1 topic (SEDP stalls)
       this file .............................. 65/65 topics, vehicle_odometry
                                                99.6 Hz (ros2 topic hz)
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <!-- The GS's fleet interface. In WSL2 mirrored networking the laptop's
           wifi appears as eth1 (10.88.27.7 on 2026-09-11). Overridden per
           session with session_bringup.sh --gs-iface. -->
      <Interfaces>
        <NetworkInterface name="eth1" priority="default" multicast="default"/>
      </Interfaces>
      <!-- Multicast for discovery only; user data goes unicast. Same reason
           as on the Jetson: wifi multicast is sent at the lowest basic rate
           and is where a 100 Hz stream goes to die. -->
      <AllowMulticast>spdp</AllowMulticast>
      <!-- REQUIRED, and the whole reason this file exists. The MicroXRCEAgent's
           Fast DDS participant on the Jetson advertises BOTH of the Jetson's
           addresses as unicast locators: 10.41.10.1 (the point-to-point link
           to the flight controller) and 10.88.38.136 (wifi). Cyclone sorts
           the locators and aims its reliable discovery (SEDP) traffic at the
           lowest one, 10.41.10.1, which the GS cannot reach, so endpoint
           discovery stalls after the first opportunistic sample and the GS
           sees 0-1 FC topics. DontRoute makes Cyclone treat any locator
           outside its own subnet as unreachable, so it uses 10.88.38.136
           only. An agent-side interface whitelist does NOT work with this
           agent build (it reads its participant QoS before Fast DDS loads
           the profile XML), so the fix has to be here. -->
      <DontRoute>true</DontRoute>
    </General>
    <Discovery>
      <!-- auto: participants take fixed ports (7410 + 2*index) so the
           Jetson's unicast SPDP can find them; required for peer discovery. -->
      <ParticipantIndex>auto</ParticipantIndex>
      <!-- Cyclone's default is 9, i.e. at most TEN participants (ROS 2
           processes, the ros2 daemon and every ros2 CLI tool included) per
           host per domain. The ground role alone runs guard + viewer +
           visualisation + RViz + preflight + daemon + whatever the crew
           types; the drone stack is exactly ten and lost two nodes to this
           on 2026-09-11. 50 on both sides, so each side's unicast SPDP also
           covers every index the other side may use. -->
      <MaxAutoParticipantIndex>50</MaxAutoParticipantIndex>
      <!-- One Peer per aircraft. DHCP LEASE -- see the header. The launcher
           rewrites this block from --jetson-peer. -->
      <Peers>
        <Peer address="10.88.38.136"/>
      </Peers>
    </Discovery>
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
