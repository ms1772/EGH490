# LFS routing for Antarctica assets is intentionally disabled in this fork.
# The .tif (terrain DEM) and .dae (thermal overlay mesh) under
# aerostack_examples/.../models/aspa135_mini3*/ are committed as their LFS
# pointer text. To restore the real binaries, clone the upstream repo
# (dipraj-debnath/ROS2_MultiUAV_3D) with `git lfs pull` and copy them in,
# or re-enable LFS tracking with:
#   *.dae filter=lfs diff=lfs merge=lfs -text
#   *.tif filter=lfs diff=lfs merge=lfs -text

# Everything here is consumed from Linux (WSL on the ground station, the
# Jetsons on the aircraft). Force LF on checkout so a Windows clone with
# core.autocrlf=true cannot turn "#!/usr/bin/env bash" into
# "#!/usr/bin/env bash\r", which Linux reports as
#     /usr/bin/env: 'bash\r': No such file or directory
# and which took a bringup down once already.
* text=auto eol=lf

# Binaries, so text detection never guesses wrong on them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pkl   binary
*.bt    binary
*.docx  binary
*.pptx  binary
*.pdf   binary
*.tif   binary
*.dae   binary
*.bin   binary
*.npy   binary
